# EcoValues Environment Configuration
# Tạo tài khoản MongoDB Atlas miễn phí tại: https://www.mongodb.com/cloud/atlas

# Chuỗi kết nối MongoDB Atlas (Thay <username>, <password>, <cluster> bằng thông tin của bạn)
MONGODB_URI=mongodb+srv://username:password@cluster0.abcde.mongodb.net/ecovalues?retryWrites=true&w=majority

# Cổng khởi chạy Server Backend Express
PORT=5000
